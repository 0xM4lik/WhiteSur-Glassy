FROM registry.fedoraproject.org/fedora:latest

RUN dnf install -y --setopt=install_weak_deps=False \
    bash \
    python3 \
    git \
    gtk3 \
    gtk4 \
    desktop-file-utils \
    findutils \
    && dnf clean all

# Create test non-root user
RUN useradd -m -u 1000 testuser
USER testuser
WORKDIR /home/testuser/WhiteSur-Glassy

COPY --chown=testuser:testuser . .

CMD ["bash", "test/run-test.sh"]
